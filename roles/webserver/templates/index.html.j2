<!DOCTYPE html>
<html>
<head>
    <title>Welcome to Ubuntu & Ansible!</title>
</head>
<body style="font-family: Arial; text-align: center; margin-top: 50px; background-color: #f4f4f4;">
    <div style="background: white; padding: 40px; display: inline-block; border-radius: 8px; box-shadow: 0px 0px 10px rgba(0,0,0,0.1);">
        <h1 style="color: #DD6B20;">Managed by Ansible Role!</h1>
        <p>Successfully deployed to host: <strong>{{ inventory_hostname }}</strong></p>
        <p>Target IP Address: <strong>{{ ansible_facts['default_ipv4']['address'] | default('N/A') }}
    </div>
</body>
</html>
